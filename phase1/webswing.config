{
  "/": {
    "path": "/",
    "security": {
      "module": "EMBEDDED",
      "config": {
        "users": [
          {
            "username": "admin",
            "password": "scratchadmin",
            "roles": [
              "admin"
            ]
          },
          {
            "username": "player1",
            "password": "scratch1",
            "roles": [
              "player"
            ]
          },
          {
            "username": "player2",
            "password": "scratch2",
            "roles": [
              "player"
            ]
          }
        ]
      }
    }
  },
  "/his": {
    "path": "/his",
    "name": "Here I Stand (500th)",
    "enabled": true,
    "maxClients": 8,
    "sessionMode": "CONTINUE_FOR_USER",
    "allowStealSession": false,
    "swingConfig": {
      "launcherType": "Desktop",
      "launcherConfig": {
        "mainClass": "VASSAL.launch.Player",
        "args": "--load /opt/vassal/modules/Here_I_Stand_500th_3.5.0.vmod"
      },
      "vmArgs": "-Xmx2g -Duser.home=/data/users/${user} -Dwebswing.trustedFontDirs=/usr/share/fonts",
      "classPathEntries": [
        "/opt/vassal/lib/Vengine.jar"
      ],
      "homeDir": "/data/users/${user}",
      "directdraw": true,
      "isolatedFs": true,
      "transferDir": "/data/transfers/${user}",
      "allowUpload": true,
      "allowDownload": true,
      "allowDelete": true,
      "fontConfig": {
        "dialog": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "dialog bold": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "dialoginput": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "sansserif": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "serif": "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
        "monospaced": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
      },
      "jreExecutable": "/opt/vassal/bin/vassal-java",
      "swingSessionTimeout": 14400,
      "timeoutIfInactive": false
    }
  },
  "/twilight-struggle": {
    "path": "/twilight-struggle",
    "name": "Twilight Struggle (Deluxe)",
    "enabled": true,
    "maxClients": 4,
    "sessionMode": "CONTINUE_FOR_USER",
    "allowStealSession": false,
    "swingConfig": {
      "launcherType": "Desktop",
      "launcherConfig": {
        "mainClass": "VASSAL.launch.Player",
        "args": "--load /opt/vassal/modules/Twilight-Struggle-3.2.vmod"
      },
      "vmArgs": "-Xmx2g -Duser.home=/data/users/${user} -Dwebswing.trustedFontDirs=/usr/share/fonts",
      "classPathEntries": [
        "/opt/vassal/lib/Vengine.jar"
      ],
      "homeDir": "/data/users/${user}",
      "directdraw": true,
      "isolatedFs": true,
      "transferDir": "/data/transfers/${user}",
      "allowUpload": true,
      "allowDownload": true,
      "allowDelete": true,
      "fontConfig": {
        "dialog": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "dialog bold": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "dialoginput": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "sansserif": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "serif": "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
        "monospaced": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
      },
      "jreExecutable": "/opt/vassal/bin/vassal-java",
      "swingSessionTimeout": 14400,
      "timeoutIfInactive": false
    }
  }
}