# vassal-portal runtime configuration.
# In the homelab these are injected by Komodo from the SOPS/OpenBao vault
# (secrets/ansible/vault_vassal.yml) — never commit real values.

# Webswing, over the stack-internal network. Never the public hostname.
WEBSWING_BASE_URL=http://vassal-webswing:8080

# Webswing's webswing.connection.secret. Signs the admin-console handshake JWT.
# Effectively a root credential for the Webswing server; portal-only.
WEBSWING_CONNECTION_SECRET=

# Secret path segment the VASSAL lobby posts its roster to. The lobby is started
# with: -URL http://vassal-portal:3000/lobby/${LOBBY_PUSH_TOKEN}/
LOBBY_PUSH_TOKEN=

# Forward-auth headers set by Traefik's chain-authentik middleware.
FORWARD_AUTH_USER_HEADER=x-authentik-username
FORWARD_AUTH_GROUPS_HEADER=x-authentik-groups

# Pipe-separated Authentik groups that get operator controls.
PORTAL_ADMIN_GROUPS=Homelab Admins

PORTAL_PUBLIC_BASE_URL=https://vassal.epikos-kyklos.com
