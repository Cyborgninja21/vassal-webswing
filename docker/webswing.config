{
  "/": {
    "path": "/",
    "security": {
      "module": "org.vassalweb.security.XForwardedUserSecurityModule",
      "classPath": [
        "${webswing.rootDir}/ext/*"
      ]
    }
  },
  "/his": {
    "path": "/his",
    "name": "Here I Stand (500th)",
    "icon": "/opt/webswing/icons/his.png",
    "enabled": true,
    "maxClients": 8,
    "sessionMode": "CONTINUE_FOR_USER",
    "allowStealSession": false,
    "swingConfig": {
      "launcherType": "Desktop",
      "launcherConfig": {
        "mainClass": "VASSAL.launch.Player",
        "args": "--load /opt/vassal/modules/Here_I_Stand_500th_3.5.0.vmod"
      },
      "vmArgs": "-Xmx2g -Duser.home=/data/users/${user} -Dwebswing.trustedFontDirs=/usr/share/fonts -Dwebswing.drawDelayMs=10",
      "classPathEntries": [
        "/opt/vassal/lib/Vengine.jar"
      ],
      "jreExecutable": "/opt/vassal/bin/vassal-java",
      "homeDir": "/data/users/${user}",
      "directdraw": false,
      "isolatedFs": true,
      "transferDir": "/data/transfers/${user}",
      "allowUpload": true,
      "allowDownload": true,
      "allowDelete": true,
      "swingSessionTimeout": 14400,
      "timeoutIfInactive": false,
      "fontConfig": {
        "dialog": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "dialog bold": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "dialoginput": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "sansserif": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "serif": "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
        "monospaced": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
      }
    }
  },
  "/twilight-struggle": {
    "path": "/twilight-struggle",
    "name": "Twilight Struggle (Deluxe)",
    "icon": "/opt/webswing/icons/twilight-struggle.png",
    "enabled": true,
    "maxClients": 4,
    "sessionMode": "CONTINUE_FOR_USER",
    "allowStealSession": false,
    "swingConfig": {
      "launcherType": "Desktop",
      "launcherConfig": {
        "mainClass": "VASSAL.launch.Player",
        "args": "--load /opt/vassal/modules/Twilight-Struggle-3.2.vmod"
      },
      "vmArgs": "-Xmx2g -Duser.home=/data/users/${user} -Dwebswing.trustedFontDirs=/usr/share/fonts -Dwebswing.drawDelayMs=10",
      "classPathEntries": [
        "/opt/vassal/lib/Vengine.jar"
      ],
      "jreExecutable": "/opt/vassal/bin/vassal-java",
      "homeDir": "/data/users/${user}",
      "directdraw": false,
      "isolatedFs": true,
      "transferDir": "/data/transfers/${user}",
      "allowUpload": true,
      "allowDownload": true,
      "allowDelete": true,
      "swingSessionTimeout": 14400,
      "timeoutIfInactive": false,
      "fontConfig": {
        "dialog": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "dialog bold": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "dialoginput": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "sansserif": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "serif": "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
        "monospaced": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
      }
    }
  },
  "/paths-of-glory": {
    "path": "/paths-of-glory",
    "name": "Paths of Glory",
    "icon": "/opt/webswing/icons/paths-of-glory.png",
    "enabled": true,
    "maxClients": 4,
    "sessionMode": "CONTINUE_FOR_USER",
    "allowStealSession": false,
    "swingConfig": {
      "launcherType": "Desktop",
      "launcherConfig": {
        "mainClass": "VASSAL.launch.Player",
        "args": "--load /opt/vassal/modules/Paths_of_Glory_10.8.vmod"
      },
      "vmArgs": "-Xmx2g -Duser.home=/data/users/${user} -Dwebswing.trustedFontDirs=/usr/share/fonts -Dwebswing.drawDelayMs=10",
      "classPathEntries": [
        "/opt/vassal/lib/Vengine.jar"
      ],
      "jreExecutable": "/opt/vassal/bin/vassal-java",
      "homeDir": "/data/users/${user}",
      "directdraw": false,
      "isolatedFs": true,
      "transferDir": "/data/transfers/${user}",
      "allowUpload": true,
      "allowDownload": true,
      "allowDelete": true,
      "swingSessionTimeout": 14400,
      "timeoutIfInactive": false,
      "fontConfig": {
        "dialog": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "dialog bold": "/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf",
        "dialoginput": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf",
        "sansserif": "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
        "serif": "/usr/share/fonts/truetype/dejavu/DejaVuSerif.ttf",
        "monospaced": "/usr/share/fonts/truetype/dejavu/DejaVuSansMono.ttf"
      }
    }
  }
}
