#!/bin/sh
# Per-session JVM wrapper: Webswing invokes this as jreExecutable for every
# Player launch. Seeds a fresh user's home from the skeleton exactly once
# (never overwrites an existing home), then execs the real java.
SKEL=/opt/vassal/skel

home=""
for arg in "$@"; do
  case "$arg" in
    -Duser.home=*) home="${arg#-Duser.home=}" ;;
  esac
done

# Fill in anything the skeleton provides that this home lacks, without ever
# overwriting a file that already exists. A plain "seed only if .VASSAL is
# missing" test would skip seeding entirely once the portal has written a
# preferences file ahead of the first launch, silently losing the rest of the
# skeleton.
if [ -n "$home" ]; then
  mkdir -p "$home"
  cp -rn "$SKEL/.VASSAL" "$home/" 2>/dev/null || true
fi

exec /opt/java/openjdk/bin/java "$@"
